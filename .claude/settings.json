{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/graphify-hint.mjs bash",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/graphify-hint.mjs read",
            "timeout": 5
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/graphify-worktree.mjs 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "graphify : graphe du worktree"
          }
        ]
      }
    ]
  }
}
